local function updateEntryFrame(frame, data)
    local idLabel = frame:FindFirstChild("IdLabel")
    if not idLabel then return end

    -- Update ID (should not change, but safe)
    idLabel.Text = data.id

    -- Update info label (priority, loop, count)
    local infoLabel = frame:FindFirstChildWhichIsA("TextLabel", true)
    -- Find the info label specifically (the third TextLabel)
    local labels = {}
    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("TextLabel") then
            table.insert(labels, child)
        end
    end
    if #labels >= 3 then
        local info = labels[3]
        info.Text = string.format("⚡ %s  |  🔁 %s  |  👁 ×%d",
            data.priority, data.looped and "Yes" or "No", data.count)
    end

    -- Update name label (second TextLabel)
    if #labels >= 2 then
        labels[2].Text = data.name ~= "" and data.name or "Unnamed Animation"
    end
end

-- ============================================================
-- ANIMATION DATA HANDLING
-- ============================================================
local function addOrUpdateAnimation(animationTrack: AnimationTrack)
    if not isScanning then return end

    local animation = animationTrack.Animation
    if not animation then return end

    local rawId = animation.AnimationId
    if rawId == "" then return end

    local id = extractId(rawId)
    local name = animation.Name or ""
    local priority = getPriorityName(animationTrack.Priority)
    local looped = animationTrack.Looped

    if animationData[id] then
        -- Update existing entry
        local data = animationData[id]
        data.count = data.count + 1
        -- Update metadata in case it changed (e.g., priority or loop)
        data.priority = priority
        data.looped = looped
        if name ~= "" then data.name = name end

        local frame = entryFrames[id]
        if frame then
            updateEntryFrame(frame, data)
        end
    else
        -- New unique ID
        local data = {
            id = id,
            name = name,
            priority = priority,
            looped = looped,
            count = 1,
        }
        animationData[id] = data

        local frame = createEntryFrame(data)
        entryFrames[id] = frame

        updateCounter()
        -- Smooth scale-in animation for new entry
        frame.Size = UDim2.new(1, 0, 0, 0)
        TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, 68)
        }):Play()
    end

    updateCounter()
end

-- ============================================================
-- CHARACTER / ANIMATOR MANAGEMENT
-- ============================================================
local function disconnectCharacterConnections()
    if animatorConnection then
        animatorConnection:Disconnect()
        animatorConnection = nil
    end
    for _, conn in ipairs(characterConnections) do
        if conn then conn:Disconnect() end
    end
    characterConnections = {}
    currentAnimator = nil
    currentHumanoid = nil
end

local function setupCharacter(character: Model)
    disconnectCharacterConnections()

    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    currentHumanoid = humanoid

    local animator = humanoid:WaitForChild("Animator", 5)
    if not animator then
        -- Sometimes Animator is added later
        animator = humanoid:FindFirstChildOfClass("Animator")
    end
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    currentAnimator = animator

    -- Connect AnimationPlayed for real-time detection
    animatorConnection = animator.AnimationPlayed:Connect(function(track)
        addOrUpdateAnimation(track)
    end)

    -- Scan currently playing animations (catch animations that started before connection)
    local playing = animator:GetPlayingAnimationTracks()
    for _, track in ipairs(playing) do
        addOrUpdateAnimation(track)
    end
end

-- ============================================================
-- RESPAWN HANDLING
-- ============================================================
local function onCharacterAdded(character: Model)
    setupCharacter(character)
end

localPlayer.CharacterAdded:Connect(onCharacterAdded)
if localPlayer.Character then
    setupCharacter(localPlayer.Character)
end

localPlayer.CharacterRemoving:Connect(function()
    disconnectCharacterConnections()
end)

