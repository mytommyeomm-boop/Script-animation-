-- ============================================================
-- NOTIFICATION SYSTEM
-- ============================================================
local notifTween = nil
local function showNotification(text, color)
    if notifTween then notifTween:Cancel() end
    notificationFrame.BackgroundColor3 = color or NEON_COLOR
    notifLabel.Text = text
    notificationFrame.BackgroundTransparency = 0.15
    notifLabel.TextTransparency = 0
    notificationFrame.Position = UDim2.new(0.5, -100, 1, -50)

    notifTween = TweenService:Create(notificationFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -100, 1, -60),
        BackgroundTransparency = 0.15,
    })
    notifTween:Play()

    task.delay(1.5, function()
        if notifTween then notifTween:Cancel() end
        notifTween = TweenService:Create(notificationFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Position = UDim2.new(0.5, -100, 1, -40),
        })
        notifTween:Play()
        notifTween.Completed:Wait()
        notifLabel.TextTransparency = 1
    end)
end

-- ============================================================
-- CLIPBOARD HELPER
-- ============================================================
-- Roblox does not expose a direct clipboard API in standard scripts.
-- We use a hidden TextBox that the user can focus and copy from (Ctrl+C / long-press).
-- Some executors provide `setclipboard`, which we try via pcall.

local function copyToClipboard(text: string, label: string)
    -- Try setclipboard if available (executor environments)
    local success = pcall(function()
        if setclipboard then
            setclipboard(text)
        end
    end)
    if success and setclipboard then
        showNotification("✅ Copied " .. label, SUCCESS_COLOR)
        return
    end

    -- Fallback: create a temporary TextBox and select its content
    local copyBox = Instance.new("TextBox")
    copyBox.Size = UDim2.new(0, 200, 0, 30)
    copyBox.Position = UDim2.new(0.5, -100, 0.5, -15)
    copyBox.BackgroundColor3 = PANEL_COLOR
    copyBox.TextColor3 = TEXT_COLOR
    copyBox.Text = text
    copyBox.Font = FONT
    copyBox.TextSize = 12
    copyBox.ClearTextOnFocus = false
    copyBox.TextEditable = true
    copyBox.ZIndex = 20
    copyBox.Parent = screenGui

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = copyBox

    copyBox:CaptureFocus()
    copyBox.CursorPosition = 1
    copyBox.SelectionStart = 1
    -- Select all text
    task.defer(function()
        copyBox.CursorPosition = #text + 1
        copyBox.SelectionStart = 1
    end)

    showNotification("📋 Select & copy: " .. label, NEON_COLOR)

    -- Auto-destroy after 4 seconds
    task.delay(4, function()
        if copyBox and copyBox.Parent then
            copyBox:Destroy()
        end
    end)
end

