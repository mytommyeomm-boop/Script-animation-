-- ============================================================
rescanBtn.MouseButton1Click:Connect(function()
    if not currentAnimator then
        showNotification("⚠️ No Animator found", DANGER_COLOR)
        return
    end

    -- Clear existing data
    animationData = {}
    for _, frame in pairs(entryFrames) do
        if frame and frame.Parent then
            frame:Destroy()
        end
    end
    entryFrames = {}
    updateCounter()

    -- Rescan currently playing
    local playing = currentAnimator:GetPlayingAnimationTracks()
    for _, track in ipairs(playing) do
        addOrUpdateAnimation(track)
    end

    showNotification("🔄 Rescanned playing animations", NEON_COLOR)
end)

