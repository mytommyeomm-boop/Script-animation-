-- ============================================================
copyAllBtn.MouseButton1Click:Connect(function()
    local ids = {}
    for id, _ in pairs(animationData) do
        table.insert(ids, id)
    end
    if #ids == 0 then
        showNotification("⚠️ No IDs to copy", DANGER_COLOR)
        return
    end
    table.sort(ids)
    local text = table.concat(ids, "\n")
    copyToClipboard(text, "All IDs")
end)

