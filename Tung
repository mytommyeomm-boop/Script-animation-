local function updateCounter()
    local count = 0
    for _ in pairs(animationData) do count = count + 1 end
    counterLabel.Text = "Unique IDs: " .. count
end

local function getPriorityName(priority: Enum.AnimationPriority): string
    local map = {
        [Enum.AnimationPriority.Core] = "Core",
        [Enum.AnimationPriority.Idle] = "Idle",
        [Enum.AnimationPriority.Movement] = "Movement",
        [Enum.AnimationPriority.Action] = "Action",
        [Enum.AnimationPriority.Action2] = "Action2",
        [Enum.AnimationPriority.Action3] = "Action3",
        [Enum.AnimationPriority.Action4] = "Action4",
    }
    return map[priority] or tostring(priority):gsub("Enum.AnimationPriority.", "")
end

